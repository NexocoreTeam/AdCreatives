{
  "blocks": [
    {"text": "The 2pm Wall Isn't\na Caffeine Problem", "font": "news", "size": 0.05, "color": "#3A2E22", "x": 0.06, "y": 0.035, "line_spacing": 1.14},
    {"text": "You fixed the coffee. You fixed the sleep. The wall stayed.", "font": "serif_reg", "size": 0.019, "color": "#5A4A38", "x": 0.06, "y": 0.155},
    {"text": "Gut energy signaling may be the missing variable.", "font": "serif_reg", "size": 0.019, "color": "#5A4A38", "x": 0.06, "y": 0.182},
    {"text": "9 a.m.", "font": "condensed", "size": 0.021, "color": "#6B5844", "x": 0.10, "y": 0.678},
    {"text": "the wall", "font": "condensed", "size": 0.022, "color": "#B5432F", "x": 0.567, "y": 0.69},
    {"text": "with steady signals", "font": "condensed", "size": 0.021, "color": "#8A6A2F", "x": 0.62, "y": 0.335},
    {"text": "The wall is a signal, not a willpower failure.", "font": "serif_reg", "size": 0.019, "color": "#5A4A38", "x": 0.06, "y": 0.90}
  ],
  "out_size": [1080, 1350]
}
