# fal.ai - Image and video generation
FAL_KEY=your_fal_key_here

# OpenAI - GPT-4o vision for reference analysis, VOC analysis
OPENAI_API_KEY=your_openai_key_here

# Anthropic - Claude for strategy, copy, briefs
ANTHROPIC_API_KEY=your_anthropic_key_here

# Higgs Field - Soul Character identity-locked image generation + file upload.
# Used by `adc remix-images --engine higgsfield-soul`, staged-mode pass 3,
# AND --engine hf-web (for the file-upload step that produces public
# CloudFront URLs for the reference + product images).
# Get keys at https://platform.higgsfield.ai (Settings -> API Keys).
# The MCP OAuth session token is NOT a REST API key - they don't interchange.
# Provide EITHER the single-field form below, OR the split HF_API_KEY +
# HF_API_SECRET pair. The client prefers HF_CREDENTIALS if both are set.
HF_CREDENTIALS=your_hf_key_id:your_hf_key_secret
# HF_API_KEY=your_hf_key_id
# HF_API_SECRET=your_hf_key_secret

# Higgs Field WEB BACKEND - the REAL nano_banana_flash edit model.
# Used by `adc remix-images --engine hf-web` (recommended for layout-faithful
# reference replication). This auth is SEPARATE from HF_API_KEY/HF_API_SECRET
# above - it's the same Clerk session your browser uses on cloud.higgsfield.ai.
#
# How to extract:
#   1. Open https://cloud.higgsfield.ai in Chrome (you'll already be logged in
#      if the official Higgsfield MCP works for you).
#   2. F12 -> Application tab -> Cookies -> https://cloud.higgsfield.ai
#   3. Copy the value of `__client` (long-lived, ~7 days) into HIGGSFIELD_CLERK_CLIENT.
#   4. Copy the value of `__session` (short-lived, ~1 min) into HIGGSFIELD_JWT.
#      Optional - the client auto-refreshes JWTs from __client. You can leave
#      HIGGSFIELD_JWT empty and it'll be minted on demand.
#
# When the __client cookie expires (~weekly), repeat steps 1-3. See
# docs/hf-web-engine.md for screenshots and troubleshooting.
HIGGSFIELD_CLERK_CLIENT=your_client_cookie_here
HIGGSFIELD_JWT=your_session_jwt_here  # optional; auto-refreshed from __client
HIGGSFIELD_DATADOME=your_datadome_cookie_here  # required: DataDome bot-challenge bypass

# OpenRouter - multi-image vision via Gemini 2.5 Pro for visual identity capture
# Falls back to Claude vision (single image) if not set.
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Apify - Meta Ad Library, Amazon Reviews, Tier 3 social scraping
APIFY_API_TOKEN=your_apify_token_here

# Optional: YouTube Data API v3 - used by `adc research-social` for the YouTube
# scrape path. Get a key at https://console.cloud.google.com (enable
# "YouTube Data API v3", then create an API key — no OAuth needed for public
# read). Free quota is 10K units/day, which is ~1M comments. Without this
# key, the YouTube path of research-social will skip per-competitor with an
# auth error in the results table (Instagram + TikTok continue to work).
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Optional: Reddit - VOC mining from subreddits
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=adcreatives/0.1

# Optional: Google Drive integration - service account JSON key path
# Used by `adc enrich-brand` and `adc analyze-references` to pull assets from
# a per-client Drive folder. Service account must have Viewer access to each
# client folder. Store the JSON OUTSIDE the repo (e.g. ~/.gcloud/) so it never
# gets committed by accident.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json

# Foreplay - ad library / swipe file sync (public + internal API both accept this token)
FOREPLAY_API_KEY=your_foreplay_key_here

# Exa - Neural web search for unfiltered VoC + competitor reviews
EXA_API_KEY=your_exa_key_here

# Canva Connect API - OAuth integration for importing/exporting Canva designs.
# This is NOT a simple API-key flow. Create a Canva Connect integration at:
# https://www.canva.com/developers/integrations
#
# Recommended setup for AdCreatives:
# - Connect API version: 2026-02-02
# - Default redirect URL: https://adcreatives.nexocore.ca/canva/oauth/callback
# - Local dev redirect, if allowed: http://127.0.0.1:8787/canva/oauth/callback
# - Start with minimal OAuth confirmation scopes: asset read/write,
#   design meta read, and folder read.
# - Add broader design/folder write scopes later only after Canva accepts them
#   in the integration portal.
CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here
CANVA_REDIRECT_URI=http://127.0.0.1:8787/canva/oauth/callback
CANVA_SCOPES=asset:read asset:write design:meta:read folder:read
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=
CANVA_API_VERSION=2026-02-02
